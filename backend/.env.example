# Neon pooled PostgreSQL connection string. Keep sslmode=require.
DATABASE_URL=
# Google Cloud OAuth web application credentials; enable only Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
# Locally generated random signing secret, at least 32 characters. Never commit it.
JWT_SIGNING_KEY=
FRONTEND_ORIGIN=http://localhost:3000
# Set true behind HTTPS in production.
COOKIE_SECURE=false
ACCESS_MINUTES=15
REFRESH_DAYS=30
AGENT_TIMEOUT_SECONDS=120
# Public directory, no API key required; manual university entry remains available.
UNIVERSITY_DIRECTORY_URL=https://raw.githubusercontent.com/Hipo/university-domains-list/master/world_universities_and_domains.json

# Built-in backend research agent.
AGENT_ENTRYPOINT=app.integrations.agent.agent_graph:research
# Optional module search directory for a custom agent.
# AGENT_PYTHON_PATH=
# Provider secrets used by the local agent; never place these in frontend code.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
