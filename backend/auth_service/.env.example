# Auth-owned identity schema; may use a separate PostgreSQL database.
DATABASE_URL=
FRONTEND_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/callback
JWT_SIGNING_KEY=
COOKIE_SECURE=false
# Production same-site subdomains: COOKIE_DOMAIN=.example.com
# Leave unset on localhost. Access cookies are shared; refresh cookies stay auth-only.
ACCESS_MINUTES=15
REFRESH_DAYS=30
# Must match platform_service; at least 32 random characters.
PLATFORM_SERVICE_TOKEN=
