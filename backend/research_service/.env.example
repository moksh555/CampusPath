PLATFORM_SERVICE_URL=http://localhost:8000
# Must match backend/platform_service/.env; generate a random secret of at least 32 characters.
RESEARCH_SERVICE_TOKEN=
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
AGENT_TIMEOUT_SECONDS=600
POLL_SECONDS=2
AGENT_ENTRYPOINT=app.agent.agent:research
# AGENT_PYTHON_PATH=

# Concurrent subagents within one session, and each unit timeout.
MAX_PARALLEL_UNITS=16
UNIT_TIMEOUT_SECONDS=120
